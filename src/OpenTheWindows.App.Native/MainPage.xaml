<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenTheWindows.App.Native.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="16">

            <Label Text="Open The Windows?" Style="{StaticResource Headline}" />
            <Label Text="Native MAUI (XAML) prototype" Style="{StaticResource SubHeadline}" />

            <Label Text="Zip code" FontAttributes="Bold" />
            <Entry x:Name="ZipCodeEntry" Placeholder="e.g. 80202" Keyboard="Numeric" MaxLength="5" />

            <Label Text="Comfortable temperature range (F)" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Entry x:Name="MinTempEntry" Placeholder="Min" Keyboard="Numeric" WidthRequest="80" />
                <Entry x:Name="MaxTempEntry" Placeholder="Max" Keyboard="Numeric" WidthRequest="80" />
            </HorizontalStackLayout>

            <Label Text="Comfortable dew point range (F)" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Entry x:Name="MinDewPointEntry" Placeholder="Min" Keyboard="Numeric" WidthRequest="80" />
                <Entry x:Name="MaxDewPointEntry" Placeholder="Max" Keyboard="Numeric" WidthRequest="80" />
            </HorizontalStackLayout>

            <Button
                x:Name="CheckButton"
                Text="Check if I should open the windows"
                Clicked="OnCheckClicked"
                HorizontalOptions="Fill" />

            <Label x:Name="ResultLabel" Text="" FontSize="18" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

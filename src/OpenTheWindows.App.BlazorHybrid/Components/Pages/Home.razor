@page "/"
@using OpenTheWindows.Core.Exercises
@using OpenTheWindows.Core.Models
@using OpenTheWindows.Core.Weather
@inject HttpClient Http
@inject IWeatherGateway WeatherGateway

<div class="mx-auto mt-4" style="max-width: 620px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <h1 class="display-5 fw-bold mb-4">Open The Windows?</h1>

            <div class="mb-3">
                <label for="zipCode" class="form-label fw-semibold">Zip code</label>
                <input id="zipCode" class="form-control" @bind="zipCode" maxlength="5" style="max-width: 140px;" />
            </div>

            <fieldset class="mb-3">
                <legend class="form-label fw-semibold">Comfortable temperature range (F)</legend>
                <div class="row g-2 align-items-center">
                    <div class="col">
                        <label for="minTemp" class="visually-hidden">Minimum comfortable temperature</label>
                        <input id="minTemp" class="form-control" @bind="minTemp" />
                    </div>
                    <div class="col-auto px-0 text-body-secondary">to</div>
                    <div class="col">
                        <label for="maxTemp" class="visually-hidden">Maximum comfortable temperature</label>
                        <input id="maxTemp" class="form-control" @bind="maxTemp" />
                    </div>
                </div>
            </fieldset>

            <fieldset class="mb-3">
                <legend class="form-label fw-semibold">Comfortable dew point range (F)</legend>
                <div class="row g-2 align-items-center">
                    <div class="col">
                        <label for="minDewPoint" class="visually-hidden">Minimum comfortable dew point</label>
                        <input id="minDewPoint" class="form-control" @bind="minDewPoint" />
                    </div>
                    <div class="col-auto px-0 text-body-secondary">to</div>
                    <div class="col">
                        <label for="maxDewPoint" class="visually-hidden">Maximum comfortable dew point</label>
                        <input id="maxDewPoint" class="form-control" @bind="maxDewPoint" />
                    </div>
                </div>
            </fieldset>

            <div class="d-grid mt-3">
                <button type="button" class="btn btn-primary btn-lg" @onclick="CheckAsync">Check if I should open the windows</button>
            </div>

            <p class="mt-3 mb-0 fw-semibold" role="status" aria-live="polite">@resultText</p>
        </div>
    </div>
</div>

@code {
    private string zipCode = "";
    private string minTemp = "60";
    private string maxTemp = "75";
    private string minDewPoint = "35";
    private string maxDewPoint = "60";
    private string resultText = "";

    private async Task CheckAsync()
    {
        resultText = "Checking...";
        try
        {
            var preferences = new ComfortPreferences
            {
                MinComfortableTemperatureF = float.Parse(minTemp),
                MaxComfortableTemperatureF = float.Parse(maxTemp),
                MinComfortableDewPointF = float.Parse(minDewPoint),
                MaxComfortableDewPointF = float.Parse(maxDewPoint),
            };

            var geocoder = new ZippopotamGeocodingService(Http);
            var location = await geocoder.GeocodeAsync(zipCode)
                ?? throw new InvalidOperationException("Could not find that zip code.");

            var stations = await WeatherGateway.GetNearbyStationsAsync(location);
            var station = WeatherStationSelector.SelectBestStation(stations);
            var reading = await WeatherGateway.GetLatestObservationAsync(station);

            var shouldOpen = ComfortEvaluator.ShouldOpenWindows(reading, preferences);

            resultText = $"{reading.TemperatureF:F0}\u00b0F, dew point {reading.DewPointF:F0}\u00b0F (from {station.Name}). " +
                (shouldOpen ? "Open the windows!" : "Keep the windows closed.");
        }
        catch (NotImplementedException)
        {
            resultText = "Waiting on the Exercises classes to be implemented!";
        }
        catch (Exception ex)
        {
            resultText = $"Something went wrong: {ex.Message}";
        }
    }
}

